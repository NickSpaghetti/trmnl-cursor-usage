<div class="layout layout--col gap--small">
  <div class="flex flex--col gap--xsmall w--full cmu-left">
    <span class="label label--small cmu-wrap">{{ handle }}</span>
    <span class="value value--base">${{ spend_dollars }}</span>
    <span class="label label--small value--tnums">{{ percent_spent | round: 0 }}% of ${{ budget_dollars }} &middot; {{ usage.totalFastRequests | number_with_delimiter }} req</span>
  </div>

  {% render 'model_bars', trmnl: trmnl, usage: usage, model_max_cents: model_max_cents, limit: 4, lg_limit: 6, show_share: false %}
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">{{ usage.name }}</span>
</div>

<div class="layout layout--col gap--xsmall">
  <div class="flex flex--col gap--xsmall w--full cmu-left">
    <span class="label label--small cmu-wrap">{{ handle }}</span>
    <span class="value value--base value--tnums">${{ spend_dollars }}</span>
    <span class="label label--small value--tnums">{{ percent_spent | round: 0 }}% of ${{ budget_dollars }}</span>
  </div>

  {% if usage.models.size > 0 %}
  {% assign top = usage.models[0] %}
  <div class="flex flex--col gap--xsmall w--full cmu-left">
    <div class="flex flex--row flex--center-y w--full">
      <span class="label label--small stretch-x cmu-min0 cmu-wrap">Top &middot; {{ top.name }}</span>
      <span class="value value--xxsmall value--tnums">${{ top.spend }}</span>
    </div>
    <div class="cmu-track w--full">
      <div class="cmu-fill" style="width: {{ top.sharePct | round: 0 | at_least: 4 }}%"></div>
    </div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image-stroke--medium" src="data:image/svg+xml;base64,{{ logo_svg | base64_encode }}" />
  <span class="title">{{ usage.name }}</span>
</div>
